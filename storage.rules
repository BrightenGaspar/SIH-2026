rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Crop harvest photos & produce verification
    match /crop_images/{cropId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Quality inspection lab certificates & GI verification
    match /quality_certificates/{certId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
