rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isValidPhoneFormat(phone) {
      return phone.matches('^[0-9]{10,13}$');
    }
    
    // ==========================================
    // 1. USERS COLLECTION (SECURED)
    // ==========================================
    match /users/{userId} {
      // Only authenticated users can read their own data or if they're admin
      allow read: if isAuthenticated() && (isOwner(userId) || hasRole('admin'));
      // Users can only create their own profile
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.phone.size() >= 10;
      // Only owner or admin can update
      allow update: if isOwner(userId) || hasRole('admin');
      // Only admin can delete
      allow delete: if hasRole('admin');
    }

    // ==========================================
    // 2. CROPS COLLECTION (MARKETPLACE LISTINGS)
    // ==========================================
    match /crops/{cropId} {
      // Authenticated users can read marketplace listings
      allow read: if isAuthenticated();
      // Only authenticated farmers can create crops
      allow create: if isAuthenticated() && hasRole('farmer') && request.resource.data.farmerId == request.auth.uid;
      // Only farmer/owner or admin can update
      allow update: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || hasRole('admin'));
      // Only farmer/owner or admin can delete
      allow delete: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || hasRole('admin'));
    }

    // ==========================================
    // 3. ORDERS & PROCUREMENT COLLECTION (SECURED)
    // ==========================================
    match /orders/{orderId} {
      // Only involved parties can read orders
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        hasRole('admin') || 
        hasRole('fpo') || 
        hasRole('logistics')
      );
      // Only authenticated buyers/farmers can create orders
      allow create: if isAuthenticated() && (hasRole('buyer') || hasRole('farmer'));
      // Only involved parties can update
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        hasRole('admin') || 
        hasRole('logistics')
      );
      // Prevent deletion (audit trail)
      allow delete: if false;
    }

    // ==========================================
    // 4. ESCROW VAULT (Immutable Financial Contracts)
    // ==========================================
    match /escrow/{escrowId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        hasRole('admin')
      );
      // Writes strictly restricted to Cloud Functions Admin SDK
      allow write: if false; 
    }

    // ==========================================
    // 5. IOT COLD-CHAIN TELEMATICS COLLECTION (SECURED)
    // ==========================================
    match /telematics/{telematicsId} {
      // Only logistics and admin can read
      allow read: if isAuthenticated() && (hasRole('logistics') || hasRole('admin'));
      // Only Cloud Functions can create via admin SDK
      allow create: if false;
      // Only logistics/admin can update
      allow update: if isAuthenticated() && (hasRole('admin') || hasRole('logistics'));
      // Prevent deletion
      allow delete: if false;
    }

    // ==========================================
    // 6. COLD STORAGE WAREHOUSES (SECURED)
    // ==========================================
    match /cold_storage/{storageId} {
      // Only warehouse staff can read
      allow read: if isAuthenticated() && (hasRole('warehouse_manager') || hasRole('admin'));
      // Only admin/warehouse manager can write
      allow write: if isAuthenticated() && (hasRole('admin') || hasRole('warehouse_manager'));
    }

    // ==========================================
    // 7. APMC MANDI & MSP PRICE BENCHMARKS (PUBLIC READ-ONLY)
    // ==========================================
    match /msp_records/{recordId} {
      // Public read access (market data)
      allow read: if true;
      // Only admin can write
      allow write: if hasRole('admin');
    }

    // ==========================================
    // 8. ROCKY AI CONVERSATIONS & VOICE LOGS (PRIVATE)
    // ==========================================
    match /ai_conversations/{convId} {
      // Only the conversation owner can read/write
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can create their own conversations
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Prevent deletion (audit trail)
      allow delete: if false;
    }
  }
}
